!/models/.gitkeep

# extract_protein_embeddings.py's large per-protein cache (~250MB combined); regeneratable
# one-time cost from a checkpoint. class_priors_km2.json (the actual pipeline output consumed by
# training_run.py --nnpu) is small and kept tracked.
/experiments/pu_cache/*.npy
/experiments/pu_cache/protein_meta.json
/experiments/pu_cache/mf_pooling_diag/*.npy
/experiments/pu_cache/mf_pooling_diag/meta.json
/experiments/pu_cache/spy_holdout/*.npy
/experiments/pu_cache/spy_holdout/protein_meta.json

# Podman sandbox files
.podman/
*.token
*.secret

