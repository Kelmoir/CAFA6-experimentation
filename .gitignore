/data/exports/*
/env/*
/data/cafa-6-protein-function-prediction/*
/data/cafa-6-protein-function-prediction.zip
/data/uniprot/*
/data/go_mappings/*
__pycache__/
/.vscode/*
/models/*
!/models/.gitkeep

# Isolated BLAST+ conda env (experiments/ensembling/blast_knn_probe_real.py) and its
# regeneratable working files (FASTA dumps, BLAST db, results, inference checkpoint)
/blast_env/*
/experiments/ensembling/blast_work/*

# extract_protein_embeddings.py's large per-protein cache (~250MB combined); regeneratable
# one-time cost from a checkpoint. class_priors_km2.json (the actual pipeline output consumed by
# training_run.py --nnpu) is small and kept tracked.
/experiments/pu_cache/*.npy
/experiments/pu_cache/protein_meta.json
/experiments/pu_cache/mf_pooling_diag/*.npy
/experiments/pu_cache/mf_pooling_diag/meta.json
/experiments/pu_cache/spy_holdout/*.npy
/experiments/pu_cache/spy_holdout/protein_meta.json

# Temporal PK/LK/NK eval harness output (experiments/pk_eval/scripts/build_temporal_pk_eval.py)
# -- regeneratable from the cached data/uniprot/uniprot_sprot.dat.gz + train_terms.tsv.
# category_summary.json is small and kept tracked, same as class_priors_km2.json above.
/experiments/pk_eval/temporal_pk_validation/*

# Item 8 label-embedding cache (experiments/label_embedding/build_term_embeddings.py) -- ~40MB,
# regeneratable from go-basic.obo + dataset_full's label list + the frozen sentence encoder.
/experiments/label_embedding/term_embeddings.pt

# Item 16 autoregressive-head training checkpoints (train_autoregressive_head.py
# --checkpoint-dir) -- GB-scale .pt files, kept locally only; promoted checkpoints get pushed
# to the HF Hub instead (see training_run.py's push_checkpoint()), never committed to git.
/experiments/label_embedding/checkpoints/
/experiments/pk_eval/temporal_pk_validation_flat/*
/experiments/pk_eval/temporal_pk_validation_flat/predictions/*
/experiments/pk_eval/cafaeval_crosscheck/*
# Item 13 GOA/PubMed attribution pull (experiments/annotator_bias/scripts/fetch_goa_attributions.py) -- ~300MB
/experiments/annotator_bias/goa_attributions.tsv
/experiments/annotator_bias/goa_attributions_chunks/*
/experiments/annotator_bias/pubmed_lastauthors.tsv
/experiments/annotator_bias/pubmed_lastauthors_chunks/*
/experiments/annotator_bias/*.log

# Item 15 local-LLM review loop (experiments/curated_evidence/scripts/local_llm_review_mutagen.py)
# -- the user's own exploratory runs against their LM Studio instance, iterated/discarded across
# several before/after prompt-fix rounds; not a single canonical result set to commit.
/experiments/curated_evidence/mutagen_review_results*.jsonl
/experiments/curated_evidence/mutagen_review_debug.log
# build_mutagen_review_tasks.py's generated task files -- regeneratable from the UniProt dump +
# go-basic.obo, and mutagen_review_tasks.json alone is 100MB+ (over GitHub's push limit).
/experiments/curated_evidence/mutagen_review_tasks*.json
# ...except the curated ground-truth files (build_claude_ground_truth.py / _leaf.py), the
# canonical reference sets for benchmarking candidate local models against.
!/experiments/curated_evidence/mutagen_review_results_claude.jsonl
!/experiments/curated_evidence/mutagen_review_results_claude_leaf.jsonl

# Podman sandbox files
.podman/
*.token
*.secret

# Sandbox environment artifact (bind-mounted to /dev/null, not real project config)
/.mcp.json
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.idea
/.profile
/.ripgreprc
/.zprofile
/.zshrc
.claude/agents
.claude/commands
.claude/hooks
.claude/launch.json
.claude/loop.md
.claude/output-styles
.claude/routines
.claude/settings.json
.claude/skills
.claude/workflows
